# Docker Compose - Restaurant stack environment

# Common
RESTAURANT_RESTART_POLICY=unless-stopped

# Mongo
RESTAURANT_MONGO_IMAGE=mongo:7
RESTAURANT_MONGO_CONTAINER_NAME=restaurant-mongo
RESTAURANT_MONGO_PORT=27018
MONGO_DB_NAME=restaurant_db

# RabbitMQ
RESTAURANT_RABBITMQ_IMAGE=rabbitmq:3.13-management
RESTAURANT_RABBITMQ_CONTAINER_NAME=restaurant-rabbitmq
RESTAURANT_RABBITMQ_PORT=5673
RESTAURANT_RABBITMQ_MANAGEMENT_PORT=15673

# Restaurant service
RESTAURANT_SERVICE_CONTAINER_NAME=restaurant-service
RESTAURANT_SERVICE_PORT=8083
SERVICE_NAME=restaurant-service
SERVICE_VERSION=dev
ENVIRONMENT=local
HTTP_PORT=8083
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=10
MONGO_URI=mongodb://restaurant-mongo:27017
RABBITMQ_URL=amqp://guest:guest@restaurant-rabbitmq:5672/
# Precisa ser o MESMO JWT_SECRET do auth-service (.env.auth): e' ele quem emite
# os tokens que as rotas admin deste servico validam.
JWT_SECRET=change-me-same-value-as-auth-service
JWT_ISSUER=auth-service
OTEL_ENABLED=false
