# Docker Compose - Restaurant stack environment

# Common
RESTAURANT_RESTART_POLICY=unless-stopped

# Mongo
RESTAURANT_MONGO_IMAGE=mongo:7
RESTAURANT_MONGO_CONTAINER_NAME=restaurant-mongo
RESTAURANT_MONGO_PORT=27018
MONGO_DB_NAME=restaurant_db

# RabbitMQ
RESTAURANT_RABBITMQ_IMAGE=rabbitmq:3.13-management
RESTAURANT_RABBITMQ_CONTAINER_NAME=restaurant-rabbitmq
RESTAURANT_RABBITMQ_PORT=5673
RESTAURANT_RABBITMQ_MANAGEMENT_PORT=15673
