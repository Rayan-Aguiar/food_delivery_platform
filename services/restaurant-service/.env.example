SERVICE_NAME=restaurant-service
SERVICE_VERSION=dev
ENVIRONMENT=local
HTTP_PORT=8083
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=10

# Infra do restaurant stack (deploy/compose/docker-compose.restaurant.yml)
MONGO_URI=mongodb://localhost:27018
MONGO_DB_NAME=restaurant_db

# Opcional: sem URL, o servico sobe sem publicar eventos de catalogo.
RABBITMQ_URL=amqp://guest:guest@localhost:5673/

# Deve ser o MESMO valor configurado como JWT_SECRET no auth-service: e' o
# auth-service quem emite os tokens que as rotas admin daqui validam.
JWT_SECRET=dev-only-shared-jwt-secret-please-rotate
JWT_ISSUER=auth-service

# Tracing OTLP/HTTP. O endpoint vem das variaveis padrao do OpenTelemetry
# (ex.: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318).
OTEL_ENABLED=false
