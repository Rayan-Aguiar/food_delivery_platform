    {
      "_id": "req_auth_register",
      "_type": "request",
      "parentId": "fld_auth_flow",
      "name": "1. Register",
      "description": "Cria o usuario do environment e ja salva os tokens. Se ja existir (409), siga para o Login.",
      "method": "POST",
      "url": "{{ _.auth_url }}/auth/register",
      "body": {
        "mimeType": "application/json",
        "text": "{\n  \"email\": \"{{ _.email }}\",\n  \"password\": \"{{ _.password }}\"\n}"
      },
      "parameters": [],
      "headers": [
        {
          "name": "Content-Type",
          "value": "application/json"
        },
        {
          "name": "Idempotency-Key",
          "value": "{% uuid 'v4' %}"
        }
      ],
      "authentication": {},
      "afterResponseScript": "// Salva campos da resposta no environment ativo.\nconst status = insomnia.response.code;\nif (status >= 200 && status < 300) {\n  const body = insomnia.response.json();\n  insomnia.environment.set(\"access_token\", body.access_token);\n  insomnia.environment.set(\"refresh_token\", body.refresh_token);\n}\n",
      "settingStoreCookies": true,
      "settingSendCookies": true,
      "settingDisableRenderRequestBody": false,
      "settingEncodeUrl": true,
      "settingRebuildPath": true,
      "settingFollowRedirects": "global",
      "metaSortKey": 8,
      "isPrivate": false,
      "created": 1795132417631,
      "modified": 1795132417631
    },
